---
import { ClientRouter } from "astro:transitions";
import Navigation from "../components/Navigation.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="theme-color"
      content="#B5728A"
    />
    <title>{title} | Nailat's Portfolio</title>
    <ClientRouter />
  </head>

  <body class="min-h-screen overflow-x-hidden bg-floral-pink text-botanical-dark">

    <!-- Subtle paper grain -->
    <div
      class="paper-grain fixed inset-0 pointer-events-none z-50"
      aria-hidden="true"
    ></div>

    <Navigation />

    <!-- Pages control their own width and spacing -->
    <main class="relative">
      <slot />
    </main>

    <script>
      import Lenis from "@studio-freight/lenis";

      let lenis: Lenis | undefined;
      let rafId = 0;

      function destroyScroll() {
        if (rafId) {
          cancelAnimationFrame(rafId);
          rafId = 0;
        }

        lenis?.destroy();
        lenis = undefined;
      }

      function initScroll() {
        destroyScroll();

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          return;
        }

        lenis = new Lenis({
          duration: 1.2,
          smoothWheel: true,
          easing: (t: number) =>
            Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        });

        function raf(time: number) {
          lenis?.raf(time);
          rafId = requestAnimationFrame(raf);
        }

        rafId = requestAnimationFrame(raf);
      }

      document.addEventListener("astro:page-load", initScroll);
      document.addEventListener("astro:before-swap", destroyScroll);
    </script>

  </body>
</html>

<style is:global>
  .paper-grain {
    opacity: 0.13;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.4'/%3E%3C/svg%3E");
  }
</style>