---
import { ClientRouter } from 'astro:transitions';
import Navigation from '../components/Navigation.astro';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Nailat's Portfolio</title>
    <ClientRouter /> 
  </head>
  <body class="bg-[#faf6ee] text-[#3c2f2f] min-h-screen relative overflow-x-hidden selection:bg-[#dfd3c3]">
    <!-- Paper Grain Visual Overlay Structure -->
    <div class="fixed inset-0 pointer-events-none opacity-[0.15] z-50 bg-[radial-gradient(#8c7a6b_1px,transparent_1px)] [background-size:16px_16px]"></div>
    
    <Navigation />
    
    <main class="container mx-auto px-6 py-12 max-w-5xl">
      <slot />
    </main>

    <!-- Global Smooth Scrolling Physics Script Configuration -->
    <script>
      import Lenis from '@studio-freight/lenis';
      
      function initScroll() {
        const lenis = new Lenis({ 
          duration: 1.2, 
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)) 
        });
        function raf(time: number) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);
      }
      
      document.addEventListener('astro:page-load', initScroll);
    </script>
  </body>
</html>