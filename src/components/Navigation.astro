<style>
  .site-nav {
    position: relative;
    z-index: 30;
  }

  .nav-link {
    position: relative;
    transition: color 0.2s ease;
  }

  .nav-link:hover {
    color: #933B5B;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: -5px;
    left: 0;
    width: 0;
    height: 1px;
    background: #933B5B;
    transition: width 0.25s ease;
  }

  .nav-link:hover::after {
    width: 100%;
  }

  @media (max-width: 480px) {
    .site-nav {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .nav-link {
      font-size: 0.75rem;
    }
  }
</style>